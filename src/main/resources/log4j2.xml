<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="info" name="spring-boot-log-test">

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{[yyyy-MM-dd]-[HH:mm:ss.SSS]} %-5p [%-7t] %F:%L - %m%n"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>